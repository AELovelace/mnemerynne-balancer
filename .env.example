# mnemerynne-balancer settings. Real environment variables win over this file.
# linux/install.sh copies this to .env and fills in the password and API key.

# ---- Control page and API -------------------------------------------------
# One port for both: the control page at /, the OpenAI-compatible API at /v1.
# npc-rag uses 9090-9093 and its copies count up from 9100, so this stays clear.
BALANCER_HOST=0.0.0.0
BALANCER_PORT=9180

# Sign-in for the control page (8+ characters, or the page won't start).
ADMIN_PASSWORD=

# Bearer key for /v1 (Mnemerynne sends it). Required: /v1 refuses every
# request until it is set. The control page can replace it (write-only).
BALANCER_API_KEY=

# Hugging Face token, only for gated repos. The control page can set it too.
HF_TOKEN=

# ---- Cards ----------------------------------------------------------------
# llama-server to run. npc-rag's build-llama.sh puts the HIP build here.
# Windows: the .exe from a llama.cpp CUDA 12 release, e.g. C:\llama.cpp\llama-server.exe
LLAMA_SERVER=/opt/llama.cpp/hip/bin/llama-server

# One llama-server per card, on these local ports (card 0, card 1).
CARD_PORTS=9181,9182

# VRAM kept free on top of the estimate when checking that a model fits
# (per card; the BFGguf keeps it on every card).
VRAM_MARGIN_MB=512

# Role on first start: balancer (one llama-server per card) or bfgguf (one
# llama-server across every card, for a model too big for one). After that
# the node keeps whatever role it was last switched to (data/state.json).
BALANCER_ROLE=balancer

# ---- Storage --------------------------------------------------------------
# Models, logs, state and the audit log. Empty: ./data next to the code.
BALANCER_DATA_DIR=/var/lib/mnemerynne-balancer
